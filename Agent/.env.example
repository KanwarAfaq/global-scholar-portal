# Database - service role required for trusted agents
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SCHOLARPORTAL_BASE_URL=https://your-domain.example

# Research fallbacks
SERPER_API_KEY=
TAVILY_API_KEY=
BING_SEARCH_API_KEY=
# DuckDuckGo HTML is the no-key final fallback.

# AI provider router
CGU_API_KEY=
CGU_API_URL=https://air.cgu.edu.tw/cgullmapi/v1/chat/completions
CGU_MODEL=gpt-4o
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
NVIDIA_NIM_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=openai/gpt-oss-20b
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# SMTP only
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@your-domain.example

# LINE
LINE_CHANNEL_ACCESS_TOKEN=
LINE_CHANNEL_SECRET=


# Optional verified social publishing
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
FACEBOOK_GRAPH_API_VERSION=v25.0
FACEBOOK_PUBLISH_ENABLED=false

# Shared fallback ordering; providers without keys are skipped.
AI_PROVIDER_ORDER=cgu,groq,nvidia-nim,mistral,openrouter,google-ai-studio,cerebras,openai
# Enable only after testing delivery with your own recipient accounts.
AGENT_ALLOW_OUTBOUND=false
# Optional sitemap submission; service account must have Search Console access.
GOOGLE_SEARCH_CONSOLE_SITE=
GOOGLE_APPLICATION_CREDENTIALS=
