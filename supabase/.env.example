# Core server configuration
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SITE_URL=https://your-domain.example
OTP_PEPPER=generate_a_long_random_secret_at_least_32_chars

# AI provider router - all configured providers are used as fallbacks.
CGU_API_KEY=
CGU_API_URL=https://air.cgu.edu.tw/cgullmapi/v1/chat/completions
CGU_MODEL=gpt-4o

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free

NVIDIA_NIM_API_KEY=
NVIDIA_NIM_URL=https://integrate.api.nvidia.com/v1/chat/completions
NVIDIA_NIM_MODEL=openai/gpt-oss-20b

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Google AI Studio. GEMINI_API_KEY and GOOGLE_AI_API_KEY are aliases; set one or both.
GEMINI_API_KEY=
GOOGLE_AI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

CEREBRAS_API_KEY=
CEREBRAS_MODEL=gpt-oss-120b

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# SMTP only - used for 4-digit auth OTP and notification email
SMTP_SERVER=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SENDER_EMAIL=noreply@your-domain.example

# Billing
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_COUNSELOR=
STRIPE_PRICE_SPONSOR=
# Optional explicit monthly aliases supported by the checkout function
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_COUNSELOR_MONTHLY=
STRIPE_PRICE_SPONSOR_MONTHLY=

# Optional admin workflow dispatch
GITHUB_ACTIONS_TOKEN=
GITHUB_REPOSITORY=owner/repository

AI_PROVIDER_ORDER=cgu,groq,nvidia-nim,mistral,openrouter,google-ai-studio,cerebras,openai
